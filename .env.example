# Django Backend Environment Variables Template

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database Configuration
# For local development, you might want to use sqlite or a local postgres
DB_NAME=inventory_database
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# KHQR Payment Configuration
KHQR_BASE_URL=https://api-bakong.nbc.gov.kh
KHQR_EMAIL=your-email@example.com
KHQR_TOKEN=your-bakong-token
KHQR_BAKONG_ACCOUNT_ID=your-bakong-id
KHQR_MERCHANT_NAME=Your Name
KHQR_MERCHANT_CITY=Phnom Penh
KHQR_APP_ICON_URL=https://yourdomain.com/logo.png
KHQR_APP_NAME=Your App Name
KHQR_APP_DEEPLINK_CALLBACK=http://localhost:3000/invoices

# Image Search Configuration
IMAGE_SEARCH_YOLO_MODEL=yolo26l.pt
IMAGE_SEARCH_DETECTION_CONFIDENCE=0.25
